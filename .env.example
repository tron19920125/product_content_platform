# 本地数据目录；不设置时默认使用项目下的 data/
PCP_DATA_ROOT=./data
PCP_GENERATION_MODE=local
PCP_QA_MODE=local
PCP_IMAGE_QUALITY=low

# 后续接入现有 Azure 资源时使用，禁止写入前端环境变量
AZURE_OPENAI_IMAGE_ENDPOINT=
AZURE_OPENAI_RESOURCE_ENDPOINT=
AZURE_OPENAI_REVIEW_ENDPOINT=
AZURE_OPENAI_BEARER_TOKEN=
AZURE_OPENAI_API_KEY=
AZURE_AI_VISION_ENDPOINT=
AZURE_AI_VISION_BEARER_TOKEN=
AZURE_AI_VISION_KEY=
