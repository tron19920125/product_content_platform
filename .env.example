# 本地数据目录；不设置时默认使用项目下的 data/
PCP_DATA_ROOT=./data
PCP_GENERATION_MODE=local
PCP_QA_MODE=local
PCP_IMAGE_QUALITY=high
PCP_IMAGE_SIZE=2048x2048

# 后续接入现有 Azure 资源时使用，禁止写入前端环境变量
# static：读取下面的 Bearer Token/API Key；managed_identity：Azure 托管身份；
# default_credential：本地使用 az login，部署到 Azure 后自动使用托管身份。
AZURE_AUTH_MODE=static
# 仅用户分配托管身份需要；系统分配托管身份留空
AZURE_MANAGED_IDENTITY_CLIENT_ID=
AZURE_OPENAI_IMAGE_ENDPOINT=
AZURE_OPENAI_IMAGE_EDIT_ENDPOINT=
AZURE_OPENAI_RESOURCE_ENDPOINT=
AZURE_OPENAI_IMAGE_DEPLOYMENT=
AZURE_OPENAI_IMAGE_API_VERSION=preview
AZURE_OPENAI_IMAGE_EDIT_API_VERSION=preview
AZURE_OPENAI_REVIEW_ENDPOINT=
AZURE_OPENAI_REVIEW_MODEL=
AZURE_OPENAI_REVIEW_API_VERSION=2025-04-01-preview
AZURE_OPENAI_BEARER_TOKEN=
AZURE_OPENAI_API_KEY=
AZURE_AI_VISION_ENDPOINT=
AZURE_AI_VISION_BEARER_TOKEN=
AZURE_AI_VISION_KEY=
